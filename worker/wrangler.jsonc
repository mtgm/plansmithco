{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "plansmith-upload",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"ALLOWED_ORIGIN": "http://localhost:5173"
	}
}